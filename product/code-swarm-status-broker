#!/usr/bin/python3
"""Opt-in status before login. Advisory only; never authorizes updates or access."""
import http.server,json,pathlib,shutil,subprocess,time,urllib.request
def command(args):
 try:return subprocess.check_output(args,text=True,stderr=subprocess.DEVNULL,timeout=2).strip()
 except (OSError,subprocess.SubprocessError):return ''
def snapshot():
 mem={l.split(':')[0]:int(l.split()[1]) for l in pathlib.Path('/proc/meminfo').read_text().splitlines()}
 disk=shutil.disk_usage('/')
 result=dict(schema=1,observed_at=time.time(),desktop='display-unavailable',app='unknown',work='unknown',authentication='unknown',same_session_vnc=False,
  updates='approval required; installation disabled',resources=dict(memory_available_mib=round(mem['MemAvailable']/1024),memory_total_mib=round(mem['MemTotal']/1024),disk_free_gib=round(disk.free/2**30,2),disk_total_gib=round(disk.total/2**30,2),uptime_seconds=int(float(pathlib.Path('/proc/uptime').read_text().split()[0]))))
 sid=command(['loginctl','show-seat','seat0','-p','ActiveSession','--value'])
 if sid:
  vals=dict(l.split('=',1) for l in command(['loginctl','show-session',sid,'-p','Class','-p','Type','-p','Name']).splitlines() if '=' in l)
  if vals.get('Class')=='greeter':result['desktop']='needs-login'
  elif vals.get('Class')=='user' and vals.get('Type')=='x11':
   result['desktop']='active'
   try:
    owner=pathlib.Path('/etc/codex-remote/owner').read_text().strip()
    if vals.get('Name')==owner:
     opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
     with opener.open('http://127.0.0.1:9072/status',timeout=3) as response:
      body=response.read(16385)
     if len(body)>16384:raise ValueError('too large')
     user=json.loads(body)
     if user.get('schema')==1 and abs(time.time()-float(user['observed_at']))<30:
      result['app']=user.get('app','unknown');result['same_session_vnc']=user.get('same_session_vnc') is True
   except Exception:pass
 greeter=command(['systemctl','is-active','code-swarm-greeter-vnc'])=='active'
 if greeter and result['desktop'] in ('needs-login','active'):result['same_session_vnc']=True
 return result
class Handler(http.server.BaseHTTPRequestHandler):
 def log_message(self,*args):pass
 def do_GET(self):
  if self.path!='/status':self.send_error(404);return
  body=json.dumps(snapshot()).encode();self.send_response(200);self.send_header('Content-Type','application/json');self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(body)));self.end_headers();self.wfile.write(body)
if __name__=='__main__':http.server.HTTPServer(('127.0.0.1',9071),Handler).serve_forever()
